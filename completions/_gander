#compdef gander
# Zsh completion for gander.
# Generated by `gander completion zsh`.
# Run with: `eval "$(gander completion zsh)"` or source it from $fpath.

_gander() {
    local -a commands
    commands=(
        'signup:Open signup form in your browser, save the API token'
        'share:Upload Markdown to gander.md and open the share link'
        'watch:Live-share a file or adopt new markdown in a directory'
        'remove:Delete a share from gander.md'
        'list:List shares currently on gander.md'
        'invite:Mint a team invite link'
        'comments:List unresolved review comments'
        'mcp:MCP stdio server, or install into agent runtimes'
        'skill:Install the agent skill (OpenCode, Claude, Cursor, Grok)'
        'uninstall:Remove CLI, MCP, skill, runner, and optionally ~/.gander'
        'status:Show the runner + active watches + URLs'
        'stop:Stop a watch (by file, id, or --all)'
        'logs:Tail the runner log (optionally filtered by watch id)'
        'runner:Install or uninstall the OS-level auto-start unit'
        'manage:Open the dashboard in your browser'
        'dashboard:Alias for manage'
        'dash:Alias for manage'
        '--d:Alias for manage'
        'auth:Install a new API token (validate against /api/shares first)'
        'completion:Print a shell completion script'
        '--upgrade:Download and install the latest release'
        'upgrade:Alias for --upgrade'
    )

    if (( CURRENT == 2 )); then
        _describe 'command' commands
        return
    fi

    case ${words[2]} in
        signup)
            _arguments \
                '--email[Email address to register]:email:' \
                '--force[Overwrite an existing saved token]'
            ;;
        share)
            _arguments \
                '--watch[Live-update the shared page as the file changes]' \
                '--foreground[Keep share --watch in-process instead of handing off to the runner]' \
                '--silent[Create or refresh without opening a browser]' \
                '--existing[With a directory, also onboard unmatched .md files already in the folder]' \
                '--no-recursive[With a directory, do not watch subdirectories]' \
                '--glob[With a directory, filename glob]:pattern:' \
                '--yes[Confirm onboarding more than 50 existing files]' \
                '--visibility[Who may see the markdown]:visibility:(anyone private hidden)' \
                '--private[Make the document private (alias for --visibility private)]' \
                '--comments[Who may comment]:comments:(anyone private disabled)' \
                '--no-comments[Turn off commenting (alias for --comments disabled)]' \
                '*--label[Set a label (repeatable; replaces the set)]:label:' \
                '--no-labels[Clear labels]' \
                '*:markdown file or directory:_files'
            ;;
        watch)
            _arguments \
                '--foreground[Run the foreground blocking watcher instead of handing off to the runner]' \
                '--silent[Create or refresh without opening a browser]' \
                '--existing[With a directory, also onboard unmatched .md files already in the folder]' \
                '--no-recursive[With a directory, do not watch subdirectories]' \
                '--glob[With a directory, filename glob]:pattern:' \
                '--yes[Confirm onboarding more than 50 existing files]' \
                '--visibility[Who may see the markdown]:visibility:(anyone private hidden)' \
                '--private[Make the document private (alias for --visibility private)]' \
                '--comments[Who may comment]:comments:(anyone private disabled)' \
                '--no-comments[Turn off commenting (alias for --comments disabled)]' \
                '*--label[Set a label (repeatable; replaces the set)]:label:' \
                '--no-labels[Clear labels]' \
                '*:markdown file or directory:_files'
            ;;
        remove)
            _arguments \
                '--all[Remove every share matching the argument]' \
                '--pick[Pick a specific short_id when ambiguous]:short_id:' \
                '--yes[Skip the confirmation prompt]' \
                '--non-interactive[Disallow prompts; require --all or --pick]' \
                '*:file or short_id:_files'
            ;;
        status)
            _arguments
            ;;
        stop)
            _arguments \
                '--all[Stop every active watch]' \
                '--yes[Skip the confirmation prompt]' \
                '--non-interactive[Refuse prompts; require --all]' \
                '1:file or short_id:_files'
            ;;
        logs)
            _arguments \
                '--follow[Keep tailing for new log lines (default)]' \
                '--no-follow[Print existing log lines and exit]' \
                '1:watch id:_files'
            ;;
        runner)
            _arguments \
                '1:action:(install uninstall)'
            ;;
        comments)
            _arguments '*:markdown file:_files -g "*.md"'
            ;;
        mcp)
            _arguments '1:action:(install)'
            ;;
        skill)
            _arguments '1:action:(install)'
            ;;
        uninstall)
            _arguments \
                '--yes[Skip the confirmation prompt]' \
                '--non-interactive[Skip the confirmation prompt]' \
                '--keep-config[Leave the profile directory in place]'
            ;;
        list)
            _arguments
            ;;
        invite)
            _arguments \
                '--email[Bind the invite to this address]:email:' \
                '--share[Embed this share as the invite origin]:short_id:'
            ;;
        manage|dashboard|dash|--d)
            _arguments
            ;;
        auth)
            _arguments \
                '1:api_token:'
            ;;
        completion)
            _arguments \
                '1:shell:(bash zsh)'
            ;;
        -upgrade|--upgrade|upgrade)
            _arguments
            ;;
        *)
            _arguments \
                '-watch[Live-reload the browser preview]' \
                '--silent[Do not open a browser; still print the preview URL]' \
                '--existing[With --watch on a directory, also onboard unmatched .md already in the folder]' \
                '--no-recursive[With --watch on a directory, do not watch subdirectories]' \
                '--glob[With --watch on a directory, filename glob]:pattern:' \
                '--yes[With --watch --existing, confirm more than 50 files]' \
                '-outfile[Write HTML to a file]:file:_files -g "*.html"' \
                '--help[Show help]' \
                '*:markdown file or directory:_files'
            ;;
    esac
}

_gander "$@"
