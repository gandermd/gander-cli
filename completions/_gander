#compdef gander
# Zsh completion for gander.
# Generated by `gander completion zsh`.
# Run with: `eval "$(gander completion zsh)"` or source it from $fpath.

_gander() {
    local -a commands
    commands=(
        'signup:Create a gander.md account and save the API token'
        'share:Upload Markdown to gander.md and open the share link'
        'remove:Delete a share from gander.md'
        'list:List shares currently on gander.md'
        'completion:Print a shell completion script'
        '--upgrade:Download and install the latest release'
        'upgrade:Alias for --upgrade'
    )

    if (( CURRENT == 2 )); then
        _describe 'command' commands
        return
    fi

    case ${words[2]} in
        signup)
            _arguments \
                '--email[Email address to register]:email:' \
                '--force[Overwrite an existing saved token]'
            ;;
        share)
            _arguments \
                '--watch[Live-update the shared page as the file changes]' \
                '*:markdown file:_files -g "*.md"'
            ;;
        remove)
            _arguments \
                '--all[Remove every share matching the argument]' \
                '--pick[Pick a specific short_id when ambiguous]:short_id:' \
                '--yes[Skip the confirmation prompt]' \
                '--non-interactive[Disallow prompts; require --all or --pick]' \
                '*:file or short_id:_files'
            ;;
        list)
            _arguments
            ;;
        completion)
            _arguments \
                '1:shell:(bash zsh)'
            ;;
        -upgrade|--upgrade|upgrade)
            _arguments
            ;;
        *)
            _arguments \
                '-watch[Live-reload the browser preview]' \
                '-outfile[Write HTML to a file]:file:_files -g "*.html"' \
                '--help[Show help]' \
                '*:markdown file:_files -g "*.md"'
            ;;
    esac
}

_gander "$@"
